---
---

<section id="descargar" class="flex flex-col items-center justify-center w-full gap-4 pt-32" data-reveal>
  <h2 class="col-span-5 font-light text-center text-white pb-6">
    Descarga GTA:SA, instala SA-MP/open.mp y forma parte de la comunidad.
  </h2>
  <div
    class="flex flex-col md:flex-row items-center justify-between gap-4 w-full px-10"
  >
    <a
      class="col-span-5 md:col-span-1 flex items-center justify-center gap-4"
      href="https://store.steampowered.com/agecheck/app/12120/"
      target="_blank"
      aria-label="Descargar Grand Theft Auto: San Andreas"
    >
      <img
        class="h-24 w-auto hover:scale-110 transition-all duration-300 select-none"
        src="/images/gta_sa.png"
        width="2300"
        height="2048"
        loading="lazy"
        alt="Grand Theft Auto: San Andreas"
      />
    </a>
    <div class="col-span-5 md:col-span-1 flex items-center justify-center">
      <span
        class="text-4xl font-bold bg-gradient-to-r from-primary via-primary to-[#e23b3b] bg-clip-text text-transparent pb-2"
        >+</span
      >
    </div>
    <a
      class="col-span-5 md:col-span-1 flex items-center justify-center gap-4"
      href="https://www.sa-mp.mp/downloads/"
      target="_blank"
      aria-label="Descargar SA-MP"
    >
      <img
        class="h-24 w-auto hover:scale-110 transition-all duration-300 select-none object-cover"
        src="/images/samp.png"
        width="620"
        height="260"
        loading="lazy"
        alt="San Andreas Multiplayer"
      />
    </a>
    <div class="col-span-5 md:col-span-1 flex items-center justify-center">
      <span
        class="text-4xl font-bold bg-gradient-to-r from-primary via-primary to-[#e23b3b] bg-clip-text text-transparent pb-2"
        >o</span
      >
    </div>
    <a
      class="col-span-5 md:col-span-1 flex items-center justify-center gap-4"
      href="https://open.mp/"
      target="_blank"
      aria-label="Descargar open.mp"
    >
      <img
        class="h-24 w-auto hover:scale-110 transition-all duration-300 select-none"
        src="/images/open_mp.png"
        width="600"
        height="600"
        loading="lazy"
        alt="Open Multiplayer"
      />
    </a>
  </div>
</section>
