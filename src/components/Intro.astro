<section class="w-full flex flex-col items-center text-center pt-32 px-4">
  <img
    src="/images/logo-clasico.png"
    width="1024"
    height="1024"
    loading="lazy"
    decoding="async"
    alt=""
    class="h-20 w-auto mb-6 select-none opacity-90"
  />
  <h2
    class="text-2xl md:text-4xl font-bold bg-gradient-to-r from-primary via-primary to-[#e23b3b] bg-clip-text text-transparent pb-2"
