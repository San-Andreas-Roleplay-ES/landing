---
const features = [
  { title: "Plazas públicas", img: "/images/features/pershing.jpg" },
  { title: "Circuitos de carreras", img: "/images/features/races.jpg" },
  { title: "Simulador de camiones", img: "/images/features/truckers.jpg" },
  { title: "Joyerías", img: "/images/features/jewelry.jpg" },
  { title: "Mangueras de incendios", img: "/images/features/fire.jpg" },
  { title: "Barrios de pandillas", img: "/images/features/idlewood.jpg" },
];
---

<section class="w-full object-cover items-center justify-center pt-32">
  <div class="flex items-center justify-center">
    <div class="w-full">
      <h2
        class="text-2xl font-bold bg-gradient-to-r from-primary to-[#e23b3b] bg-clip-text text-transparent"
      >
        Características
      </h2>
      <p class="text-xl md:text-3xl text-white font-bold pb-1 leading-tight">
        <strong class="font-extrabold">Nuevos modelos 3D</strong> que conservan,
        embellecen y expanden el arte original de Grand Theft Auto San Andreas.
      </p>
      <div class="grid grid-cols-3 gap-16 mt-8">
        {
          features.map((feature) => (
            <article class="col-span-3 md:col-span-1 flex flex-col gap-4">
              <h3 class="text-lg font-bold bg-gradient-to-r from-primary to-[#e23b3b] bg-clip-text text-transparent">
                {feature.title}
              </h3>
              <a
                href="https://github.com/San-Andreas-Roleplay-ES/samp-docs"
                target="_blank"
                rel="noopener"
                aria-label={`${feature.title} — documentación en GitHub`}
                class="aspect-square w-full border border-primary rounded-lg overflow-hidden group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1800]"
              >
                <img
                  src={feature.img}
                  alt={feature.title}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover select-none transition-transform duration-300 group-hover:scale-110"
                />
              </a>
            </article>
          ))
        }
        <article class="col-span-3 flex flex-col gap-4">
          <p
            class="text-lg font-bold bg-gradient-to-r from-primary to-[#e23b3b] bg-clip-text text-transparent text-center"
          >
            ¡Descubre sistemas únicos que no encontrarás en ningún otro servidor
            de SA-MP!
          </p>
        </article>
      </div>
    </div>
  </div>
</section>
