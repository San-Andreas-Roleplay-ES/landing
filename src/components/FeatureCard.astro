---
// Reusable feature card: full-width image as a faded header, then text below.
// This is the unified pattern for every feature section (originally the
// "Mundo ilegal" treatment). Optional CTA link and named slots for extras
// (gallery, embedded video, etc.) rendered under the body copy.
interface Props {
  title: string;
  /** DOM id de la sección (ancla desde el hero mosaico / nav lateral). */
  id?: string;
  image: string;
  alt: string;
  width: number;
  height: number;
  kicker?: string;
  href?: string;
  ctaLabel?: string;
  /** Same-origin CTA: drops target="_blank"/rel and renders an in-tab link. */
  ctaInternal?: boolean;
  /** Heading color: gradient gold->red accent (default) or plain white. */
  headingStyle?: "gradient" | "white";
  /** Side of the optional `aside` slot image relative to the body text. */
  asideSide?: "left" | "right";
}

const {
  title,
  id,
  image,
  alt,
  width,
  height,
  kicker,
  href,
  ctaLabel,
  ctaInternal = false,
  headingStyle = "gradient",
  asideSide = "right",
} = Astro.props;

const headingClass =
  headingStyle === "white"
    ? "text-2xl md:text-4xl font-bold text-white pb-2"
    : "text-2xl md:text-4xl font-bold bg-gradient-to-r from-primary via-primary to-[#e23b3b] bg-clip-text text-transparent pb-2";
---

<section id={id} class="w-full pt-16 md:pt-24 scroll-mt-24" data-reveal>
  <article
    class="feature-card rounded-2xl overflow-clip border border-[#2a2a2a] bg-[#0d0d0d]"
    data-spotlight
  >
    <div class="relative overflow-clip">
      <img
        src={image}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
        alt={alt}
        class="feature-parallax feature-fade w-full h-72 md:h-96 object-cover select-none"
      />
      {
        kicker && (
          <span class="absolute top-4 left-4 rounded-md border border-white/15 bg-black/55 px-3 py-1 text-xs font-bold tracking-[0.2em] uppercase text-primary backdrop-blur-sm">
            {kicker}
          </span>
        )
      }
    </div>

    <div class="p-6 md:p-10">
      <h2 class={headingClass}>{title}</h2>

      {
        Astro.slots.has("aside") ? (
          <div
            class:list={[
              "mt-2 flex flex-col md:items-center gap-8",
              asideSide === "left" ? "md:flex-row-reverse" : "md:flex-row",
            ]}
          >
            <p class="text-md text-gray-200 md:w-1/2">
              <slot />
            </p>
            <div class="md:w-1/2 flex justify-center">
              <slot name="aside" />
            </div>
          </div>
        ) : (
          <p class="text-md mt-2 text-gray-200 max-w-3xl">
            <slot />
          </p>
        )
      }

      <slot name="extras" />

      <!--
        CTA primario de conversión en cada tarjeta (el momento de interés es
        aquí, no al final de la página). El enlace informativo (`href`) queda
        como acción secundaria para no sacar al visitante de la landing.
      -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href="https://ucp.sarp.es/auth/signup"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-bold rounded-lg bg-primary text-black uppercase tracking-wide transition-transform duration-300 hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-[#0d0d0d]"
        >
          Crear cuenta gratis
        </a>
        {
          href && (
            <a
              href={href}
              target={ctaInternal ? undefined : "_blank"}
              rel={ctaInternal ? undefined : "noopener"}
              class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold rounded-lg text-primary underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-[#0d0d0d]"
            >
              {ctaLabel ?? "Saber más"}
              <span aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
    </div>
  </article>
</section>
