---
import type { DocGroup } from "../../lib/docs";

// Índice de guías con filtro. Se usa dos veces: columna fija (lg+) y panel
// flotante de la barra móvil. El script de DocsLayout lo cablea por instancia
// (raíz `data-docs-index`).
interface Props {
  groups: DocGroup[];
  /** Slug activo (undefined en /docs). */
  slug?: string;
  /** Sufijo para ids únicos cuando hay varias instancias en la página. */
  instance: string;
}

const { groups, slug, instance } = Astro.props;
const isIndex = !slug;
---

<div data-docs-index>
  <label class="block">
    <span class="sr-only">Filtrar guías</span>
    <input
      id={`docs-filter-${instance}`}
      type="search"
      placeholder="Buscar guía…"
      autocomplete="off"
      data-filter
      class="w-full rounded-lg border border-white/10 bg-black/40 px-3 py-2 text-sm text-white placeholder:text-gray-500 focus:border-primary focus:outline-none"
    />
  </label>
  <a
    href="/docs"
    class:list={[
      "mt-3 block rounded-md px-2 py-1.5 text-sm font-semibold hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary",
      isIndex ? "text-primary bg-primary/10" : "text-gray-200",
    ]}
    aria-current={isIndex ? "page" : undefined}>Inicio de la documentación</a
  >
  {
    groups.map((g) => (
      <div class="mt-4" data-group>
        <p class="px-2 text-[11px] font-bold uppercase tracking-[0.18em] text-gray-500">
          {g.name}
        </p>
        <ul class="mt-1">
          {g.docs.map((d) => (
            <li data-doc={d.title.toLowerCase()}>
              <a
                href={d.href}
                aria-current={d.slug === slug ? "page" : undefined}
                class:list={[
                  "block rounded-md px-2 py-1.5 text-sm leading-snug transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary",
                  d.slug === slug
                    ? "text-primary bg-primary/10 font-semibold"
                    : "text-gray-300",
                ]}
              >
                {d.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
  <p class="mt-3 px-2 text-sm text-gray-500" data-filter-empty hidden>
    Ninguna guía coincide.
  </p>
</div>
