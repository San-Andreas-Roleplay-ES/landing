---
import { getGlobalMetrics } from "../services/data";

const { metrics } = await getGlobalMetrics();
const nf = new Intl.NumberFormat("es-ES");

// Trust stats baked into the HTML at build time (the CDN JSON has no CORS, so
// a live client fetch is impossible). We lead with figures that age well —
// the weekly record and cumulative totals — not a misleading real-time count.
const stats = [
  { value: metrics.weeklyPeakPlayers, label: "Jugadores conectados" },
  { value: metrics.accountCounter, label: "Cuentas registradas", plus: true },
  { value: metrics.characterCounter, label: "Personajes creados", plus: true },
];
---

<section
  class="relative w-full min-h-[44rem] md:min-h-screen overflow-hidden flex items-center justify-center"
>
  <img
    src="/images/background.png"
    width="1920"
    height="1080"
    fetchpriority="high"
    style="mask-image: linear-gradient(black 25%, transparent)"
    class="absolute inset-0 hidden md:block w-full h-full object-cover"
    alt=""
  />
  <div
    class="relative z-10 max-w-5xl w-full flex flex-col items-center justify-center text-center gap-y-4 p-4 pt-24 md:pt-4"
  >
    <a
      href="http://ucp.sarp.es/"
      target="_blank"
      rel="noopener"
      aria-label="Ir al panel de control de usuario de San Andreas Roleplay"
      class="rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1800]"
    >
      <img
        src="/images/logo.png"
        width="1024"
        height="1024"
        alt="San Andreas Roleplay"
        class="h-44 md:h-60 w-auto m-0 select-none scale-90 md:hover:scale-105 md:hover:-rotate-2 transition-all duration-300 filter [filter:drop-shadow(0_0_40px_rgba(252,175,23,0.5))_drop-shadow(0_0_10px_rgba(180,25,25,0.4))] md:hover:[filter:drop-shadow(0_0_60px_rgba(252,175,23,0.7))_drop-shadow(0_0_20px_rgba(180,25,25,0.5))]"
      />
    </a>

    <p
      class="text-xs md:text-sm font-semibold tracking-[0.2em] uppercase text-primary"
    >
      Servidor de rol en español · SA-MP / open.mp
    </p>

    <h1
      class="max-w-3xl text-3xl md:text-5xl font-extrabold leading-tight text-white"
    >
      San Andreas Roleplay: el <span
        class="bg-gradient-to-r from-primary via-primary to-[#e23b3b] bg-clip-text text-transparent"
        >rol pesado en español</span
      > de <span class="whitespace-nowrap">GTA San Andreas</span>
    </h1>

    <p class="max-w-2xl text-base md:text-lg text-gray-200">
      <span class="whitespace-nowrap">GTA San Andreas</span> en pleno 2026 sigue
      más vivo que nunca. Facciones criminales, cuerpos oficiales, casinos,
      elecciones y tu propia historia te esperan en el rol escrito más inmersivo.
      <span class="text-white font-semibold"
        >Tu historia te espera en San Andreas.</span
      >
    </p>

    <div class="flex flex-col sm:flex-row items-center gap-3 mt-2">
      <a
        class="px-6 py-3 text-base font-bold rounded-lg bg-primary text-black uppercase tracking-wide transition-transform duration-300 hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1800]"
        href="https://ucp.sarp.es/auth/signup"
        target="_blank"
        rel="noopener"
      >
        Crear cuenta gratis
      </a>
      <a
        class="flex items-center gap-2 px-5 py-3 text-base font-bold rounded-lg bg-[#5865f2] text-white transition-transform duration-300 hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5865f2] focus-visible:ring-offset-2 focus-visible:ring-offset-[#1a1800]"
        href="https://discord.gg/sa-rp"
        target="_blank"
        rel="noopener"
        aria-label="Unirse al servidor de Discord de San Andreas Roleplay"
      >
        <img src="/images/discord.png" width="891" height="633" alt="" class="h-5 w-auto" />
        Discord
      </a>
    </div>

    <div class="flex items-stretch mt-2 rounded-lg overflow-hidden border border-primary/40 bg-[#0d0d0d]">
      <a
        class="flex items-center gap-2 px-4 py-2 text-sm font-mono text-primary hover:bg-primary/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset"
        href="samp://play.sarp.es:7777"
        rel="noopener"
        aria-label="Conectarse al servidor de San Andreas Roleplay (play.sarp.es, puerto 7777)"
      >
        <span aria-hidden="true">🎮</span>
        play.sarp.es:7777
      </a>
      <button
        type="button"
        id="copyIpBtn"
        data-ip="play.sarp.es:7777"
        class="px-3 border-l border-primary/40 text-gray-300 hover:text-primary hover:bg-primary/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset"
        aria-label="Copiar la IP del servidor"
      >
        <span id="copyIpLabel" class="text-xs font-semibold uppercase tracking-wide"
          >Copiar</span
        >
      </button>
    </div>

    <dl
      class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mt-4 text-center"
    >
      {
        stats.map((stat) => (
          <div class="flex flex-col">
            <dt class="sr-only">{stat.label}</dt>
            <dd class="text-2xl md:text-3xl font-extrabold text-primary">
              {stat.plus ? "+" : ""}
              {nf.format(stat.value)}
            </dd>
            <span class="text-xs md:text-sm text-gray-300">{stat.label}</span>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  const btn = document.getElementById("copyIpBtn");
  const label = document.getElementById("copyIpLabel");
  if (btn && label) {
    btn.addEventListener("click", async () => {
      const ip = btn.dataset.ip ?? "play.sarp.es:7777";
      try {
        await navigator.clipboard.writeText(ip);
        const prev = label.textContent;
        label.textContent = "¡Copiado!";
        setTimeout(() => (label.textContent = prev), 1500);
      } catch {
        /* clipboard unavailable — ignore */
      }
    });
  }
</script>
