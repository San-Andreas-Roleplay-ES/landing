---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import {
  docDescription,
  docFirstImage,
  docKeywords,
  docTitle,
  docWordCount,
  getDocSequence,
} from "../../lib/docs";

// Una página estática por cada docs/<slug>.md del repo de documentación.
export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries
    .filter((e) => e.id !== "index")
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const title = docTitle(entry);
const description =
  docDescription(entry) ||
  `${title}: guía oficial de San Andreas Roleplay para GTA San Andreas en SA-MP.`;

const sequence = await getDocSequence();
const i = sequence.findIndex((d) => d.slug === entry.id);
const prev = i > 0 ? sequence[i - 1] : null;
const next = i >= 0 && i < sequence.length - 1 ? sequence[i + 1] : null;
---

<DocsLayout
  title={title}
  description={description}
  slug={entry.id}
  headings={headings}
  prev={prev}
  next={next}
  image={docFirstImage(entry)}
  keywords={docKeywords(entry)}
  wordCount={docWordCount(entry)}
>
  <Content />
</DocsLayout>
