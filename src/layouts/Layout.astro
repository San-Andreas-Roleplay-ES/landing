---
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative OG image path. Resolved against the site origin. */
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title = "San Andreas Roleplay - GTA Roleplay - San Andreas Multiplayer en español",
  description = "Comunidad de roleplay en español sobre GTA San Andreas (SA-MP). Crea tu personaje, únete a facciones legales e ilegales, consigue skins gratis y vive eventos cada semana. +11.900 cuentas y +13.000 personajes. Entra a play.sarp.es.",
  image = "/images/logo-squared.png",
  type = "website",
  noindex = false,
} = Astro.props;

// Canonical / OG URLs are built from the served origin (gta-rol.com, set as
// `site` in astro.config.mjs). All in-page action links point to sarp.es.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const siteName = "San Andreas Roleplay";

// One linked JSON-LD graph (Organization + WebSite + VideoGame) so search
// engines treat gta-rol.com and sarp.es as a single brand entity.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://gta-rol.com/#organization",
      name: siteName,
      alternateName: ["SARP", "SARP.es"],
      url: "https://gta-rol.com/",
      logo: new URL("/images/logo-squared.png", Astro.site).href,
      description:
        "Comunidad de roleplay pesado basado en texto sobre GTA San Andreas en SA-MP / open.mp.",
      sameAs: [
        "https://sarp.es",
        "https://forum.sarp.es",
        "https://ucp.sarp.es",
        "https://discord.gg/sa-rp",
        "https://github.com/San-Andreas-Roleplay-ES",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://gta-rol.com/#website",
      name: siteName,
      url: "https://gta-rol.com/",
      inLanguage: "es",
      publisher: { "@id": "https://gta-rol.com/#organization" },
    },
    {
      "@type": "VideoGame",
      "@id": "https://gta-rol.com/#videogame",
      name: siteName,
      alternateName: "SARP",
      url: "https://gta-rol.com/",
      image: ogImage,
      inLanguage: "es",
      applicationCategory: "Game",
      operatingSystem: "Windows",
      gamePlatform: ["SA-MP", "open.mp", "PC"],
      genre: ["Roleplay", "MMORPG", "Rol basado en texto"],
      playMode: "MultiPlayer",
      publisher: { "@id": "https://gta-rol.com/#organization" },
      description:
        "Servidor de rol pesado en español sobre GTA San Andreas: facciones legales e ilegales, economía, eventos y narrativa interpretativa.",
    },
  ],
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta name="author" content={siteName} />
    <meta name="copyright" content={siteName} />
    <meta
      name="keywords"
      content="GTA San Andreas roleplay, SA-MP rol, rol pesado, roleplay en español, servidor SAMP rol, GTA SA RP, rol basado en texto, open.mp, comunidad de rol"
    />
    <meta name="theme-color" content="#1a1800" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta
      property="og:image:alt"
      content={`${siteName} — rol de GTA San Andreas en SA-MP`}
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content={`${siteName} — rol de GTA San Andreas`}
    />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-Y3FW37XPHJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-Y3FW37XPHJ");
    </script>

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
    <style is:global>
      ::-webkit-scrollbar {
        width: 12px;
      }

      ::-webkit-scrollbar-track {
        background: #1a1800;
        border-radius: 6px;
      }

      ::-webkit-scrollbar-thumb {
        background: linear-gradient(to bottom, #fcaf17, #b41919);
        border-radius: 6px;
        border: 2px solid #1a1800;
      }

      ::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(to bottom, #ffc107, #d32f2f);
      }

      * {
        scrollbar-width: thin;
        scrollbar-color: #fcaf17 #1a1800;
      }
    </style>
  </head>
  <body
    class="bg-fixed bg-center bg-repeat-x bg-[#1a1800]"
    style="background-image: url('/images/gangtags.png')"
  >
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-reveal (mejora progresiva, SEO-safe): solo ocultamos los
      // elementos marcados cuando este script corre. Sin JS o con
      // prefers-reduced-motion, todo queda visible sin animación.
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (!reduce && "IntersectionObserver" in window && els.length) {
        document.documentElement.classList.add("js-reveal");
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                obs.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
