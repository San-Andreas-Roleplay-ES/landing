---
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import "../styles/global.css";
import { ADS } from "../data/ads";

const DEFAULT_KEYWORDS =
  "GTA San Andreas roleplay, GTA Roleplay, GTA SA rol, SA-MP, San Andreas Multiplayer, rol en español, roleplay en español, juego de rol, Los Santos - Juego de Rol, San Andreas Roleplay, SARP, rol pesado, rol basado en texto, servidor SA-MP rol, open.mp, MTA:SA, Multi Theft Auto, GTA SA, GTA Mods, GTA Underground, GTA Online";

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative OG image path. Resolved against the site origin. */
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  /** Page-specific extra keywords, appended to the brand defaults. */
  keywords?: string;
  /** ISO 8601; only rendered for type="article" (Open Graph article:*). */
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = "San Andreas Roleplay | GTA San Andreas Rol en SA-MP — Los Santos - Juego de Rol en español",
  description = "San Andreas Roleplay: juego de rol en español sobre GTA San Andreas en SA-MP. Vive Los Santos - Juego de Rol con facciones legales e ilegales, skins gratis y eventos. +13.000 personajes. Entra a play.sarp.es.",
  image = "/images/logo-squared.png",
  type = "website",
  noindex = false,
  keywords,
  publishedTime,
  modifiedTime,
} = Astro.props;

const metaKeywords = keywords
  ? `${DEFAULT_KEYWORDS}, ${keywords}`
  : DEFAULT_KEYWORDS;

// Canonical / OG URLs are built from the served origin (gta-rol.com, set as
// `site` in astro.config.mjs). All in-page action links point to sarp.es.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const siteName = "San Andreas Roleplay";

// One linked JSON-LD graph (Organization + WebSite + VideoGame) so search
// engines treat gta-rol.com and sarp.es as a single brand entity.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://gta-rol.com/#organization",
      name: siteName,
      alternateName: ["SARP", "SARP.es"],
      url: "https://gta-rol.com/",
      logo: new URL("/images/logo-squared.png", Astro.site).href,
      description:
        "Comunidad de roleplay pesado basado en texto sobre GTA San Andreas en SA-MP / open.mp.",
      sameAs: [
        "https://sarp.es",
        "https://forum.sarp.es",
        "https://ucp.sarp.es",
        "https://discord.gg/sa-rp",
        "https://github.com/San-Andreas-Roleplay-ES",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://gta-rol.com/#website",
      name: siteName,
      url: "https://gta-rol.com/",
      inLanguage: "es",
      publisher: { "@id": "https://gta-rol.com/#organization" },
    },
    {
      "@type": "VideoGame",
      "@id": "https://gta-rol.com/#videogame",
      name: siteName,
      alternateName: [
        "SARP",
        "Los Santos - Juego de Rol",
        "GTA San Andreas Roleplay",
      ],
      url: "https://gta-rol.com/",
      image: ogImage,
      inLanguage: "es",
      applicationCategory: "Game",
      operatingSystem: "Windows",
      gamePlatform: ["SA-MP", "open.mp", "PC"],
      genre: ["Roleplay", "MMORPG", "Sandbox", "Rol basado en texto"],
      keywords:
        "GTA San Andreas roleplay, GTA Roleplay, SA-MP, San Andreas Multiplayer, rol en español, juego de rol, Los Santos - Juego de Rol, MTA:SA, GTA SA, open.mp",
      playMode: "MultiPlayer",
      publisher: { "@id": "https://gta-rol.com/#organization" },
      gameItem: {
        "@type": "Thing",
        name: "Grand Theft Auto: San Andreas",
      },
      description:
        "Servidor de juego de rol en español sobre GTA San Andreas en SA-MP: rol pesado en la ciudad de Los Santos - Juego de Rol con facciones legales e ilegales, economía, eventos y narrativa interpretativa escrita.",
    },
  ],
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta name="author" content={siteName} />
    <meta name="copyright" content={siteName} />
    <meta name="keywords" content={metaKeywords} />
    <meta name="theme-color" content="#1a1800" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta
      property="og:image:alt"
      content={`${siteName} — rol de GTA San Andreas en SA-MP`}
    />
    {
      type === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      type === "article" && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content={`${siteName} — rol de GTA San Andreas`}
    />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-Y3FW37XPHJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-Y3FW37XPHJ");
    </script>

    {
      ADS.enabled && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.client}`}
          crossorigin="anonymous"
        />
      )
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
    <style is:global>
      ::-webkit-scrollbar {
        width: 12px;
      }

      ::-webkit-scrollbar-track {
        background: #1a1800;
        border-radius: 6px;
      }

      ::-webkit-scrollbar-thumb {
        background: linear-gradient(to bottom, #fcaf17, #b41919);
        border-radius: 6px;
        border: 2px solid #1a1800;
      }

      ::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(to bottom, #ffc107, #d32f2f);
      }

      * {
        scrollbar-width: thin;
        scrollbar-color: #fcaf17 #1a1800;
      }
    </style>
  </head>
  <body
    class="bg-fixed bg-center bg-repeat-x bg-[#1a1800]"
    style="background-image: url('/images/gangtags.png')"
  >
    <div class="scroll-progress" aria-hidden="true"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-reveal (mejora progresiva, SEO-safe): solo ocultamos los
      // elementos marcados cuando este script corre. Sin JS o con
      // prefers-reduced-motion, todo queda visible sin animación.
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      // GA4: eventos de comportamiento (vista de sección, clic en celda del
      // mosaico, CTAs con la sección de origen). No-op si gtag no cargó.
      const track = (name: string, params: Record<string, unknown>) => {
        const g = (window as unknown as { gtag?: (...a: unknown[]) => void })
          .gtag;
        if (typeof g === "function") g("event", name, params);
      };

      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (!reduce && "IntersectionObserver" in window && els.length) {
        document.documentElement.classList.add("js-reveal");
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                obs.unobserve(entry.target);
                const id = (entry.target as HTMLElement).id;
                if (id) track("section_view", { section_id: id });
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
        );
        els.forEach((el) => io.observe(el));

        // "Spotlight": la tarjeta que cruza la franja central de la pantalla
        // se muestra al 100 %; el resto queda atenuado (revelado una a una).
        const spots = document.querySelectorAll<HTMLElement>("[data-spotlight]");
        if (spots.length) {
          const spot = new IntersectionObserver(
            (entries) => {
              for (const e of entries)
                e.target.classList.toggle("is-active", e.isIntersecting);
            },
            { rootMargin: "-30% 0px -30% 0px" },
          );
          spots.forEach((el) => spot.observe(el));
        }
      }

      document.addEventListener("click", (ev) => {
        const a = (ev.target as Element | null)?.closest?.("a");
        if (!a) return;
        const scope = a.closest("section, nav, footer");
        const section = scope?.id || scope?.tagName.toLowerCase() || "page";
        if (a.dataset.tile) {
          track("tile_click", { tile_id: a.dataset.tile });
          return;
        }
        const href = a.getAttribute("href") ?? "";
        let cta: string | null = null;
        if (/ucp\.sarp\.es\/auth\/signup/.test(href)) cta = "signup";
        else if (/discord\.gg/.test(href)) cta = "discord";
        else if (/^samp:/.test(href)) cta = "connect";
        if (cta) track("cta_click", { cta, section_id: section });
      });
    </script>
  </body>
</html>
